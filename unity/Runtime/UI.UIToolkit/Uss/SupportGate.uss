/* Оформление формы — перенос стилей веб-версии (sdk/js/src/ui/styles.ts) на USS.
   Размеры ×1.6 от веба: панель рассчитана на PanelSettings с опорной шириной
   ~1080 px. Подключается к панели игрой; чтобы заменить своим, добавьте свой
   стиль после этого — правила с той же специфичностью перекрывают.

   Палитра веба: фон #ffffff, текст #11181c, приглушённый #5c6b73,
   линии #d7dee3, акцент #1f6feb, ошибка #c5221f. */

.sg-root {
    width: 1440px;
    max-width: 96%;
    max-height: 96%;
    background-color: rgb(255, 255, 255);
    border-radius: 16px;
    color: rgb(17, 24, 28);
    font-size: 22px;
    overflow: hidden;
}

.sg-root Label,
.sg-root Button,
.sg-root TextField,
.sg-root DropdownField {
    font-size: 22px;
    color: rgb(17, 24, 28);
    margin: 0;
}

/* Шапка: заголовок и крестик, снизу линия. */
.sg-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 24px 32px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(215, 222, 227);
}

.sg-title {
    font-size: 26px;
    -unity-font-style: bold;
    flex-shrink: 1;
    white-space: normal;
}

.sg-close {
    font-size: 36px;
    color: rgb(92, 107, 115);
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 10px;
    padding: 4px 14px;
    -unity-text-align: middle-center;
}

.sg-close:hover {
    background-color: rgba(0, 0, 0, 0.06);
}

/* Тело прокручивается, подвал остаётся на месте. */
.sg-body {
    flex-grow: 1;
    flex-shrink: 1;
    padding: 22px 32px;
}

.sg-body .unity-scroll-view__content-container {
    flex-grow: 1;
}

.sg-banner {
    margin: 22px 32px 0 32px;
    padding: 16px 20px;
    border-radius: 12px;
    background-color: rgb(253, 236, 234);
    color: rgb(197, 34, 31);
    white-space: normal;
}

.sg-state-box {
    padding: 44px 32px;
    align-items: center;
}

.sg-state {
    -unity-text-align: middle-center;
    color: rgb(92, 107, 115);
    white-space: normal;
}

/* Две колонки 2:3, как в вебе; узкий экран — одна (sg-narrow). */
.sg-columns {
    flex-direction: row;
}

.sg-col {
    flex-grow: 2;
    flex-basis: 0;
    min-width: 0;
}

.sg-col-text {
    flex-grow: 3;
    margin-left: 32px;
}

.sg-narrow .sg-columns {
    flex-direction: column;
}

.sg-narrow .sg-col-text {
    margin-left: 0;
}

.sg-field {
    margin-bottom: 16px;
}

.sg-label {
    margin-bottom: 6px;
    -unity-font-style: bold;
    white-space: normal;
}

/* Встроенная подпись контрола стоит слева; в вебе она сверху — своя Label. */
.sg-control > .unity-base-field__label {
    display: none;
}

.sg-control > .unity-base-field__input {
    flex-grow: 1;
    margin: 0;
    padding: 12px 16px;
    min-height: 56px;
    background-color: rgb(255, 255, 255);
    border-width: 1px;
    border-color: rgb(215, 222, 227);
    border-radius: 12px;
    color: rgb(17, 24, 28);
}

.sg-control > .unity-base-field__input:hover {
    border-color: rgb(191, 200, 206);
}

.sg-control:focus > .unity-base-field__input,
.sg-control > .unity-base-field__input:focus {
    border-width: 2px;
    border-color: rgb(31, 111, 235);
}

.sg-control:disabled > .unity-base-field__input {
    background-color: rgb(243, 245, 247);
    color: rgb(92, 107, 115);
}

.sg-invalid .sg-control > .unity-base-field__input {
    border-color: rgb(197, 34, 31);
}

.sg-control .unity-base-popup-field__text {
    flex-grow: 1;
}

.sg-control .unity-base-popup-field__arrow {
    -unity-background-image-tint-color: rgb(92, 107, 115);
}

.sg-multiline > .unity-base-field__input {
    min-height: 220px;
    white-space: normal;
}

.sg-field-description {
    flex-grow: 1;
}

.sg-field-description > .sg-control {
    flex-grow: 1;
}

.sg-hint {
    margin-top: 6px;
    font-size: 19px;
    color: rgb(92, 107, 115);
    white-space: normal;
}

.sg-error {
    margin-top: 6px;
    font-size: 19px;
    color: rgb(197, 34, 31);
    white-space: normal;
}

/* Вложения: плитки 180 px в ряд с переносом, последняя — «Добавить файлы». */
.sg-files {
    flex-direction: row;
    flex-wrap: wrap;
}

.sg-drop,
.sg-file {
    width: 180px;
    min-height: 180px;
    margin: 0 16px 16px 0;
    border-radius: 12px;
    overflow: hidden;
}

.sg-drop {
    align-items: center;
    justify-content: center;
    border-width: 2px;
    border-color: rgb(215, 222, 227);
    background-color: rgba(0, 0, 0, 0);
    color: rgb(92, 107, 115);
}

.sg-drop:hover {
    border-color: rgb(31, 111, 235);
    background-color: rgba(31, 111, 235, 0.06);
}

.sg-drop:disabled {
    opacity: 0.6;
}

.sg-drop-icon {
    font-size: 42px;
    color: rgb(31, 111, 235);
}

.sg-drop-text {
    font-size: 19px;
    color: rgb(92, 107, 115);
    -unity-text-align: middle-center;
    white-space: normal;
    padding: 0 8px;
}

.sg-file {
    border-width: 1px;
    border-color: rgb(215, 222, 227);
    background-color: rgb(255, 255, 255);
}

.sg-thumb {
    height: 128px;
    align-items: center;
    justify-content: center;
    background-color: rgb(238, 241, 244);
    overflow: hidden;
}

.sg-thumb-image {
    width: 100%;
    height: 100%;
}

.sg-thumb-ext {
    font-size: 19px;
    -unity-font-style: bold;
    color: rgb(92, 107, 115);
}

.sg-file-pending .sg-thumb {
    opacity: 0.5;
}

.sg-file-meta {
    padding: 8px 10px;
}

.sg-file .sg-name {
    font-size: 17px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.sg-file .sg-size {
    font-size: 17px;
    color: rgb(92, 107, 115);
}

.sg-remove {
    position: absolute;
    top: 6px;
    right: 6px;
    width: 36px;
    height: 36px;
    padding: 0;
    margin: 0;
    border-width: 0;
    border-radius: 18px;
    background-color: rgba(14, 20, 24, 0.7);
    color: rgb(255, 255, 255);
    font-size: 26px;
    -unity-text-align: middle-center;
}

.sg-remove:hover {
    background-color: rgb(197, 34, 31);
}

/* Подвал с кнопками, сверху линия. */
.sg-footer {
    flex-direction: row;
    justify-content: flex-end;
    padding: 22px 32px;
    border-top-width: 1px;
    border-top-color: rgb(215, 222, 227);
}

.sg-button {
    padding: 14px 26px;
    margin-left: 12px;
    border-radius: 12px;
    border-width: 1px;
    border-color: rgb(215, 222, 227);
    background-color: rgb(255, 255, 255);
    color: rgb(17, 24, 28);
}

.sg-button:hover {
    background-color: rgb(243, 245, 247);
}

.sg-button:disabled {
    opacity: 0.6;
}

.sg-primary {
    background-color: rgb(31, 111, 235);
    border-color: rgb(31, 111, 235);
    color: rgb(255, 255, 255);
}

.sg-primary:hover {
    background-color: rgb(26, 95, 208);
}

/* Языки с письмом справа налево: направление отдаёт сервер (direction: rtl). */
.sg-rtl Label {
    -unity-text-align: middle-right;
}

.sg-rtl .sg-header,
.sg-rtl .sg-columns,
.sg-rtl .sg-files,
.sg-rtl .sg-footer {
    flex-direction: row-reverse;
}

.sg-rtl .sg-col-text {
    margin-left: 0;
    margin-right: 32px;
}

.sg-rtl.sg-narrow .sg-columns {
    flex-direction: column;
}

.sg-rtl.sg-narrow .sg-col-text {
    margin-right: 0;
}

.sg-rtl .sg-drop,
.sg-rtl .sg-file {
    margin: 0 0 16px 16px;
}

.sg-rtl .sg-remove {
    right: auto;
    left: 6px;
}

.sg-rtl .sg-button {
    margin-left: 0;
    margin-right: 12px;
}
